# Cloudflare Pages: unknown paths already fall back to index.html (SPA mode, no 404.html present).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
# Impressum and privacy policy name the operator: keep them out of search results (the rest stays indexable)
/impressum
  X-Robots-Tag: noindex, nofollow
/datenschutz
  X-Robots-Tag: noindex, nofollow
/fr/impressum
  X-Robots-Tag: noindex, nofollow
/fr/datenschutz
  X-Robots-Tag: noindex, nofollow
/haftungsausschluss
  X-Robots-Tag: noindex, nofollow
/fr/haftungsausschluss
  X-Robots-Tag: noindex, nofollow
