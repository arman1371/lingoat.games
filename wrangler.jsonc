{
  "name": "lingoat-games",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // only /img/* runs the Worker (photos from R2); everything else is a plain static asset
    "run_worker_first": ["/img/*"],
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "lingoat-images" }],
  "previews": {},
}
