# Copy to .env.local (git-ignored) for local builds. In production set these as build variables.
# Shown in the Impressum and privacy policy. Without them those pages show a "not configured" notice.
VITE_OPERATOR_NAME=
VITE_OPERATOR_STREET=
VITE_OPERATOR_CITY=
VITE_OPERATOR_EMAIL=
# Public Cloudflare Turnstile site key; without it the "Report a problem" button stays hidden.
VITE_TURNSTILE_SITE_KEY=
